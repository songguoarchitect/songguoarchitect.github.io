{%- comment -%}
  卡片：支持 nolink
  用法：在某个项目的 front-matter 里加 nolink: true 即可使卡片不可点击
{%- endcomment -%}

<div class="col">

  {%- comment -%} 计算跳转链接：link > redirect > url {%- endcomment -%}
  {% if project.link %}
    {% assign _href = project.link %}
  {% elsif project.redirect %}
    {% assign _href = project.redirect %}
  {% else %}
    {% assign _href = project.url | relative_url %}
  {% endif %}
  {%- comment -%} 是否禁用点击 {%- endcomment -%}
  {% assign _is_nolink = project.nolink | default: false %}

  {%- if _is_nolink %}
    <!-- 不可点击版本：不包 <a> -->
    <div class="card h-100 hoverable is-nolink">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes="250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title" style="font-size: 1.25rem; font-weight: 700;">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>

        {% if project.funding %}
          <div class="project-funding mt-2">
            <strong>Funding:</strong>
            {% if project.funding | kind_of: 'Array' %}
              {{ project.funding | join: '; ' }}
            {% else %}
              {{ project.funding }}
            {% endif %}
          </div>
        {% endif %}

        {% if project.role %}
          <div class="project-role mt-1">
            <strong>Role:</strong> {{ project.role }}
          </div>
        {% endif %}

        {% if project.institution %}
          <div class="project-role mt-1">
            <strong>Institution:</strong> {{ project.institution }}
          </div>
        {% endif %}

        <div class="row ml-1 mr-1 p-0">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>

  {%- else %}
    <!-- 可点击版本：保留 <a> 包裹 -->
    <a href="{{ _href }}">
      <div class="card h-100 hoverable">
        {% if project.video %}
          <video
            class="card-img-top"
            src="{{ project.video }}"
            {% if project.img %}poster="{{ project.img }}"{% endif %}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            style="width:100%;height:auto;display:block;border-top-left-radius:var(--bs-card-inner-border-radius,0.375rem);border-top-right-radius:var(--bs-card-inner-border-radius,0.375rem);">
          </video>
        {% elsif project.img %}
          {%
            include figure.liquid
            loading="eager"
            path=project.img
            sizes="250px"
            alt="project thumbnail"
            class="card-img-top"
          %}
        {% endif %}
        <div class="card-body">
          <h2 class="card-title" style="font-size: 1.25rem; font-weight: 700;">{{ project.title }}</h2>
          <p class="card-text">{{ project.description }}</p>

          {% if project.funding %}
            <div class="project-funding mt-2">
              <strong>Funding:</strong>
              {% if project.funding | kind_of: 'Array' %}
                {{ project.funding | join: '; ' }}
              {% else %}
                {{ project.funding }}
              {% endif %}
            </div>
          {% endif %}

          {% if project.role %}
            <div class="project-role mt-1">
              <strong>Role:</strong> {{ project.role }}
            </div>
          {% endif %}

          {% if project.institution %}
            <div class="project-role mt-1">
              <strong>Institution:</strong> {{ project.institution }}
            </div>
          {% endif %}

          <div class="row ml-1 mr-1 p-0">
            {% if project.github %}
              <div class="github-icon">
                <div class="icon" data-toggle="tooltip" title="Code Repository">
                  <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
                </div>
                {% if project.github_stars %}
                  <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                    <i class="fa-solid fa-star"></i>
                    <span id="{{ project.github_stars }}-stars"></span>
                  </span>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </a>
  {%- endif %}

</div>
